# SlothDesk AI Environment Configuration

# Server
ENVIRONMENT=development
PORT=8000

# Database
DATABASE_URL=sqlite:///./data/slothdesk.db

# Ollama & Gemma 3 4B Configuration
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=gemma3:4b
OLLAMA_TIMEOUT_SECONDS=30.0

# Document & Processing Constraints
MAX_DOCUMENT_SIZE_MB=15
MAX_DOCUMENT_CHARS=40000

# Privacy & Demo
DEMO_MODE=false
